{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phototek",
  "version": "0.1.23",
  "identifier": "lu.webcms.phototek",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Phototek",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http: https: https://tile.openstreetmap.org thumb: http://thumb.localhost importthumb: http://importthumb.localhost photo: http://photo.localhost; media-src 'self' http: https: photo: http://photo.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://api.github.com http: https: thumb: http://thumb.localhost photo: http://photo.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "Photo browser for any folder",
    "longDescription": "Browse photos in any folder: a NAS, an external drive or a local disk. Originals are never modified; favorites and albums are shared by every computer that opens the folder.",
    "linux": {
      "deb": {
        "depends": [
          "libheif1",
          "libheif-plugin-libde265",
          "gstreamer1.0-libav",
          "ffmpeg"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "upgradeCode": "0a82bb92-bbf4-531a-9bf6-ca1622c676e1"
      }
    },
    "createUpdaterArtifacts": true,
    "iOS": {
      "developmentTeam": "7LMT79E5E4",
      "minimumSystemVersion": "16.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMDYxREQyOTE2QjQ2NzcKUldSM1JtdVIwaDBHd1hFK2hYczdnN1l4Q0hjaEdldnl2akx0N3pvYkRFbU91dmVXZGFyc3lFcUoK",
      "endpoints": [
        "https://github.com/webcmslu/phototek/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
